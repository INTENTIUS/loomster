node_modules/
dist/
*.log
.DS_Store

# docker-build's `into: "archive"` build-archive tarball (a real chant run's
# Build phase writes this to the project root, relative to cwd) — never a
# source artifact.
archive

# Upstream awslabs/loom checkout (pinned tag) — the docker-build context for
# loom-backend/loom-frontend. Not vendored into this repo; see
# src/components/loom-backend.component.ts's docstring.
vendor/
.gitlab-ci-local/

# github-runtime-e2e generated workflow (on-demand, never committed)
test/github-runtime-e2e/ci.yml

# forgejo-runtime-e2e generated workflow (on-demand, never committed)
test/forgejo-runtime-e2e/ci.yml

# chant update's synced type and schema copies (regenerated, never committed)
.chant/types/

# claims runner state (the aws claims instance, the spend-guard cache) and logs
test/.state/
# cognito/user-client's probe module, removed when the claim ends
.claim-frontend-*.ts

# Claude Code agent worktrees
.claude/worktrees/

# scripts/db/schema.sh's throwaway copy of the db/ project (Loom schema import)
db/.scratch/
