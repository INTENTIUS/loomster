{
  "name": "loom-on-chant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Production deployment of awslabs/loom (pinned v1.9.0) on chant \u2014 component-based, tiered light/production/production-ha, generated CI.",
  "scripts": {
    "tsc": "tsc --noEmit",
    "lint": "chant lint .",
    "test": "vitest run",
    "synth:shared-foundation": "chant build src/shared-foundation --lexicon aws -o dist/shared-foundation.template.json",
    "synth:downstream-stub": "chant build src/downstream-stub --lexicon aws -o dist/downstream-stub.template.json",
    "synth:loom-db": "chant build src/loom-db --lexicon aws -o dist/loom-db.template.json",
    "synth:loom-cognito": "chant build src/loom-cognito --lexicon aws -o dist/loom-cognito.template.json",
    "synth:loom-backend": "chant build src/loom-backend --lexicon aws -o dist/loom-backend.template.json",
    "synth:loom-frontend": "chant build src/loom-frontend --lexicon aws -o dist/loom-frontend.template.json",
    "synth:loom-agents": "chant build src/loom-agents --lexicon aws -o dist/loom-agents.template.json",
    "synth": "npm run synth:shared-foundation && npm run synth:downstream-stub && npm run synth:loom-db && npm run synth:loom-cognito && npm run synth:loom-backend && npm run synth:loom-frontend && npm run synth:loom-agents && npm run ops:build",
    "watch": "chant run loom-watch",
    "reconcile": "chant run loom-reconcile",
    "audit": "chant run loom-audit",
    "backup": "chant run loom-backup",
    "cognito-export": "chant run loom-cognito-export",
    "restore": "chant run loom-restore",
    "restore-drill": "chant run loom-restore-drill",
    "dns-setup": "chant run loom-dns-setup",
    "bootstrap": "chant run loom-bootstrap",
    "seed": "chant run loom-seed",
    "validate": "tsx scripts/validate/run.ts",
    "estimate-cost": "bash scripts/estimate-cost.sh",
    "generate:gitlab": "chant build --components --generate gitlab -o .gitlab/components.yml",
    "generate:github": "chant build --components --generate github -o .github/workflows/components.yml",
    "generate:forgejo": "chant build --components --generate forgejo -o .forgejo/workflows/components.yml",
    "ops:build": "chant build ops",
    "export-bundle": "bash scripts/export-bundle.sh",
    "vendor": "bash scripts/vendor-loom.sh"
  },
  "dependencies": {
    "@intentius/chant": "^0.124.15",
    "@intentius/chant-lexicon-aws": "^0.124.15",
    "@intentius/chant-lexicon-docker": "^0.124.15",
    "@intentius/chant-lexicon-forgejo": "^0.124.15",
    "@intentius/chant-lexicon-github": "^0.124.15",
    "@intentius/chant-lexicon-gitlab": "^0.124.15"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
